<?xml version="1.0" encoding="utf-8"?>
<ui version="4.0">
 <class>MasonrySpacingGridPage</class>
 <widget class="QWidget" name="MasonrySpacingGridPage">
  <layout class="QVBoxLayout" name="pageLayout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>分别控制行间距、列间距、内容边距和分割线。中心模式总是穿过交叉间距；两侧模式可控制是否穿过。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="controls">
     <item row="0" column="0">
      <widget class="QSpinBox" name="rows">
       <property name="prefix">
        <string>行间距 </string>
       </property>
       <property name="minimum">
        <number>0</number>
       </property>
       <property name="maximum">
        <number>40</number>
       </property>
       <property name="value">
        <number>10</number>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QSpinBox" name="columns">
       <property name="prefix">
        <string>列间距 </string>
       </property>
       <property name="minimum">
        <number>0</number>
       </property>
       <property name="maximum">
        <number>40</number>
       </property>
       <property name="value">
        <number>10</number>
       </property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QSpinBox" name="margins">
       <property name="prefix">
        <string>内容边距 </string>
       </property>
       <property name="minimum">
        <number>0</number>
       </property>
       <property name="maximum">
        <number>40</number>
       </property>
       <property name="value">
        <number>0</number>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QComboBox" name="placement">
       <item>
        <property name="text">
         <string>SpacingCenter</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>SpacingEdges</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QCheckBox" name="horizontal">
       <property name="text">
        <string>横线</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="1" column="2">
      <widget class="QCheckBox" name="vertical">
       <property name="text">
        <string>竖线</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QCheckBox" name="through">
       <property name="text">
        <string>两侧模式穿过间距</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="lineWidth">
       <property name="prefix">
        <string>线宽 </string>
       </property>
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>5</number>
       </property>
       <property name="value">
        <number>1</number>
       </property>
      </widget>
     </item>
     <item row="2" column="2">
      <widget class="QCheckBox" name="colored">
       <property name="text">
        <string>间距背景色</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="viv::VirtualMasonryView" name="view" />
