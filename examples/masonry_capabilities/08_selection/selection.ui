   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>选择保存的是模型索引，与物化控件是否还在屏幕内无关。ExtendedSelection 使用 Ctrl 增减、Shift 扩选；键盘按空间邻近项目导航。</string>
