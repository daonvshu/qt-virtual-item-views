 <class>MasonryScrollingPage</class>
 <widget class="QWidget" name="MasonryScrollingPage">
  <layout class="QVBoxLayout" name="pageLayout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>大量数据不必预先创建 QStandardItem 和 QWidget。overscan 按每列项目计数；pin 保留指定物化项。性能探测还需打开 viv.performance.* 日志分类。</string>
