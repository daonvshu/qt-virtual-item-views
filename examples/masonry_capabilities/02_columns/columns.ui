 <class>MasonryColumnsPage</class>
 <widget class="QWidget" name="MasonryColumnsPage">
  <layout class="QVBoxLayout" name="pageLayout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>列数 0 表示自动计算；正数请求固定列数，仍受最小列宽限制。列不是数据字段，改变窗口宽度会重新排布。</string>
