<?xml version="1.0" encoding="utf-8"?>
<ui version="4.0">
 <class>MasonryAutoHeightPage</class>
 <widget class="QWidget" name="MasonryAutoHeightPage">
  <layout class="QVBoxLayout" name="pageLayout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>少量项目时高度跟随所有列的最大底部；超过自适应高度上限才滚动；0 表示不限高，父空间不足由业务处理。不需要内部滚动时，滚轮交给外层滚动区域。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="controls">
     <item row="0" column="0">
      <widget class="QSpinBox" name="count">
       <property name="prefix">
        <string>项目数 </string>
       </property>
       <property name="minimum">
        <number>0</number>
       </property>
       <property name="maximum">
        <number>300</number>
       </property>
       <property name="value">
        <number>4</number>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QSpinBox" name="maximum"><property name="specialValueText"><string>不限高</string></property>
       <property name="prefix">
        <string>最大高度 </string>
       </property>
       <property name="minimum">
        <number>0</number>
       </property>
       <property name="maximum">
        <number>600</number>
       </property>
       <property name="value">
        <number>280</number>
       </property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QCheckBox" name="adaptive">
       <property name="text">
        <string>自适应高度</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QCheckBox" name="forceBar">
       <property name="text">
        <string>强制显示滚动条</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QCheckBox" name="trailing">
       <property name="text">
        <string>始终绘制底线</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QScrollArea" name="outer">
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <widget class="QWidget" name="scrollContent">
      <layout class="QVBoxLayout" name="contentLayout">
       <item>
        <widget class="QLabel" name="outerHint">
         <property name="text">
          <string>外层滚动区域：鼠标放在无需内部滚动的瀑布流上，滚轮应继续滚动外层。</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="viv::VirtualMasonryView" name="view" />
       </item>
       <item>
        <spacer name="outerSpacer"><property name="sizeType"><enum>QSizePolicy::MinimumExpanding</enum></property>
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint">
          <size>
           <width>20</width>
           <height>500</height>
          </size>
         </property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="outerBottom">
         <property name="text">
          <string>外层内容底部</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="status">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="minimumSize">
      <size>
       <width>0</width>
       <height>42</height>
      </size>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <customwidgets>
