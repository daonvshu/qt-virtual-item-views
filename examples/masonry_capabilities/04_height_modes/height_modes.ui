       </property>
       <property name="value">
        <double>1.5</double>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QCheckBox" name="invalid">
       <property name="text">
        <string>首项使用无效估算</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="viv::VirtualMasonryView" name="view" />
