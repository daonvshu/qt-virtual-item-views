<ui version="4.0">
 <class>MasonryHeightModesPage</class>
 <widget class="QWidget" name="MasonryHeightModesPage">
  <layout class="QVBoxLayout" name="pageLayout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>Fixed 使用统一高度；AspectRatio 使用全局宽高比；AdapterEstimate 使用每项 QSize 比例，非法估算回退到固定高度。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="controls">
     <item row="0" column="0">
      <widget class="QComboBox" name="mode">
       <item>
        <property name="text">
         <string>AdapterEstimate</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Fixed</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>AspectRatio</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QSpinBox" name="fixed">
       <property name="prefix">
