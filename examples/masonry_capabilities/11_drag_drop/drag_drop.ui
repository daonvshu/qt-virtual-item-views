<ui version="4.0">
 <class>MasonryDragDropPage</class>
 <widget class="QWidget" name="MasonryDragDropPage">
  <layout class="QVBoxLayout" name="pageLayout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>自动模式从卡片主体按下并移动起拖；手动模式只响应左侧手柄。模型负责 MIME 和数据插入，框架负责预览、pin、落点和结束清理。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="controls">
     <item row="0" column="0">
      <widget class="QComboBox" name="mode">
       <item>
        <property name="text">
         <string>Automatic</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Manual</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QComboBox" name="action">
       <item>
        <property name="text">
         <string>Move</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Copy</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QCheckBox" name="indicator">
       <property name="text">
        <string>显示落点</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QSpinBox" name="width">
