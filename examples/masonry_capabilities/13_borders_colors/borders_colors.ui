       <property name="text">
        <string>右边框</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="1" column="2">
      <widget class="QCheckBox" name="bottom">
       <property name="text">
        <string>下边框</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
