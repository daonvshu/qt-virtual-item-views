        <string>浅色项目底色</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="2" column="2">
      <widget class="QCheckBox" name="spacing">
       <property name="text">
        <string>间距背景色</string>
       </property>
       <property name="checked">
        <bool>false</bool>
