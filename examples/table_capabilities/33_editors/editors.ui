<?xml version="1.0" encoding="utf-8"?>
<ui version="4.0">
 <class>TableEditorsPage</class>
 <widget class="QWidget" name="TableEditorsPage">
  <layout class="QVBoxLayout" name="layout">
   <item><widget class="QLabel" name="description">
    <property name="text"><string>33 覆盖编辑器：列1单击，列2双击/F2，列3格内按钮编辑数量（UserRole+1），列4外部触发，列5单击打开业务 Popup（用弹窗内按钮确认/取消）。Enter提交，Esc取消，Tab/Shift+Tab切换；空文本拒绝提交。末行只读。</string></property>
    <property name="wordWrap"><bool>true</bool></property>
   </widget></item>
   <item><layout class="QHBoxLayout" name="controls">
    <item><widget class="QPushButton" name="editCurrent"><property name="text"><string>编辑当前单元格（外部触发）</string></property></widget></item>
    <item><widget class="QPushButton" name="commit"><property name="text"><string>提交覆盖编辑器</string></property><property name="focusPolicy"><enum>Qt::NoFocus</enum></property></widget></item>
    <item><widget class="QPushButton" name="cancel"><property name="text"><string>取消当前编辑（含 Popup）</string></property><property name="focusPolicy"><enum>Qt::NoFocus</enum></property></widget></item>
   </layout></item>
   <item><widget class="viv::VirtualTableView" name="view"/></item>
   <item><widget class="QLabel" name="status"><property name="text"><string>单元格展示控件保持不变；编辑器由框架覆盖显示和销毁。</string></property></widget></item>
  </layout>
 </widget>
 <customwidgets><customwidget><class>viv::VirtualTableView</class><extends>QAbstractScrollArea</extends><header>virtualitemviews/virtualtableview.h</header></customwidget></customwidgets>
