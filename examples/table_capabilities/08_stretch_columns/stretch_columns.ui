<ui version="4.0">
 <class>TableStretchColumnsPage</class>
 <widget class="QWidget" name="TableStretchColumnsPage">
  <layout class="QVBoxLayout" name="layout" stretch="0,0,1">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>08 列宽模式：普通模式下任意列调宽后固定全部列；填满视图模式保持总宽不变，由拖动侧的列按现有宽度比例分摊</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="controls">
     <item>
      <widget class="QPushButton" name="apply">
       <property name="text">
        <string>恢复 1:2:1 比例</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="fixedWidth">
       <property name="text">
        <string>设置列 3 宽度为 200</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="last">
       <property name="text">
        <string>拉伸末列</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="fit">
       <property name="text">
        <string>填满视图（两侧比例调宽）</string>
       </property>
       <property name="toolTip">
        <string>在目标列内靠近左边界拖动，由左侧列分摊；靠近右边界拖动，由右侧列分摊。最外侧边界固定。</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="spacer1">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeType">
        <enum>QSizePolicy::Expanding</enum>
       </property>
       <property name="sizeHint">
        <size>
         <width>0</width>
         <height>0</height>
        </size>
       </property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="viv::VirtualTableView" name="view" />
   </item>
  </layout>
 </widget>
