<ui version="4.0">
 <class>FlowCellSizes</class>
 <widget class="QWidget" name="FlowCellSizes">
  <layout class="QVBoxLayout" name="pageLayout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>02 尺寸与自动换列：配置目标列宽、固定高度或宽高比；最小列宽是期望值，窄窗口优先铺满。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="controls">
     <item row="0" column="0">
      <widget class="QLabel" name="minimumLabel">
       <property name="text">
        <string>最小目标宽度</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QSpinBox" name="minimum">
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>600</number>
       </property>
       <property name="value">
        <number>100</number>
       </property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QLabel" name="maximumLabel">
       <property name="text">
        <string>最大目标宽度</string>
       </property>
      </widget>
     </item>
     <item row="0" column="3">
      <widget class="QSpinBox" name="maximum">
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>1000</number>
       </property>
       <property name="value">
        <number>200</number>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="modeLabel">
       <property name="text">
        <string>高度模式</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QComboBox" name="mode">
       <item>
        <property name="text">
         <string>固定高度</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>宽高比</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="1" column="2">
      <widget class="QLabel" name="heightLabel">
       <property name="text">
        <string>固定高度</string>
       </property>
      </widget>
     </item>
     <item row="1" column="3">
      <widget class="QSpinBox" name="height">
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>500</number>
       </property>
       <property name="value">
        <number>100</number>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="ratioLabel">
       <property name="text">
        <string>宽 / 高</string>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QDoubleSpinBox" name="ratio">
       <property name="minimum">
        <double>0.1</double>
       </property>
       <property name="maximum">
        <double>10</double>
       </property>
       <property name="value">
        <double>1.5</double>
       </property>
       <property name="singleStep">
        <double>0.1</double>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="viv::VirtualFlowTableView" name="view" />
