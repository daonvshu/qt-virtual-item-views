<ui version="4.0">
 <class>TreeDragAnimationPage</class>
 <widget class="QWidget" name="TreeDragAnimationPage">
  <layout class="QVBoxLayout" name="layout" stretch="0,0,1,0">
   <item>
    <widget class="QLabel" name="description">
     <property name="text">
      <string>20 拖动位移动画：起拖时立即收起源节点，只用主节点的单行高度让位，子树数据仍一起移动。取消或放下后保持收起。子树末尾允许多层级投放时，空白描边按目标层级缩进。拖到分支的上下边缘插入，拖到中间成为子项（显示目标框）；复制使用指示器。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="controls">
     <item>
