<ui version="4.0">
 <class>ListDragDropPage</class>
 <widget class="QWidget" name="ListDragDropPage">
  <layout class="QVBoxLayout" name="layout" stretch="0,0,0,1,0">
   <item>
    <widget class="QLabel" name="intro">
     <property name="text">
      <string>15 指示器拖动：Automatic 从行内容起拖，Manual 只从手柄起拖。插入线标记落点，可调整颜色、线宽和线型；靠近边缘自动滚动，Esc 取消。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="controls">
     <item>
