<?xml version="1.0" encoding="utf-8"?>
<ui version="4.0">
 <class>ListScrollingPage</class>
 <widget class="QWidget" name="ListScrollingPage">
  <layout class="QVBoxLayout" name="layout" stretch="0,0,0,0,1,0">
   <item>
    <widget class="QLabel" name="intro">
     <property name="text">
      <string>12 滚动：默认百万行；开启一亿行后总高度 36 亿像素，超过 32 位有符号范围。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="wheel">
     <item>
      <widget class="QComboBox" name="wheelMode">
       <item>
        <property name="text">
         <string>滚轮按像素</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>滚轮按项</string>
        </property>
       </item>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="step">
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>200</number>
       </property>
       <property name="value">
        <number>48</number>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="large">
       <property name="text">
        <string>一亿行 / 64 位滚动范围</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="jumpControls">
     <item>
      <widget class="QSpinBox" name="row">
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>1000000</number>
       </property>
       <property name="prefix">
        <string>第 </string>
       </property>
       <property name="suffix">
        <string> 行</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="hint">
       <item>
        <property name="text">
         <string>确保可见</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>顶部</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>底部</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>居中</string>
        </property>
       </item>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="jump">
       <property name="text">
        <string>定位</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="pixels" stretch="1,0,0,0,0">
     <item>
      <widget class="QLineEdit" name="offset">
       <property name="text">
        <string>0</string>
       </property>
       <property name="placeholderText">
        <string>输入非负 64 位像素偏移</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="setOffset">
       <property name="text">
        <string>设置偏移</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="up">
       <property name="text">
        <string>上移 24 px</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="down">
       <property name="text">
        <string>下移 24 px</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="autoScroll">
       <property name="text">
        <string>像素自动滚动</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="viv::VirtualListView" name="view" />
   </item>
   <item>
    <widget class="QLabel" name="status" />
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>viv::VirtualListView</class>
